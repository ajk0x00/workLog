# WorkLog Application Configuration
PORT=3000
APP_PORT=80
NODE_ENV=production

# Authentication
JWT_SECRET=worklog-super-secret-key-change-in-production-2026
JWT_EXPIRES_IN=7d

# ----------------------------------------------------
# External PostgreSQL Database Connection String
# ----------------------------------------------------
# Replace with your external database connection string.
# Examples:
# - Neon / Supabase / Render: postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/worklog?sslmode=require
# - AWS RDS / Cloud SQL: postgresql://postgres:your_password@db-host.com:5432/worklog
# - Local fallback: postgresql://postgres:postgres@localhost:5432/worklog
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worklog

# Enable SSL for remote cloud databases (Neon, Supabase, AWS RDS, Cloud SQL)
DB_SSL=true
