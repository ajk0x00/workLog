# WorkLog Application Configuration
PORT=3000
APP_PORT=80
NODE_ENV=production

# Authentication
JWT_SECRET=worklog-super-secret-key-change-in-production-2026
JWT_EXPIRES_IN=7d

# ----------------------------------------------------
# PostgreSQL Database Connection Options
# ----------------------------------------------------
# Option A: Local host PostgreSQL (when running in Docker container)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/worklog
DB_SSL=false

# Option B: Docker Compose local Postgres container
# Run: docker compose --profile local-db up -d
# DATABASE_URL=postgresql://postgres:postgres@db:5432/worklog
# DB_SSL=false

# Option C: External Cloud Database (Neon, Supabase, Cloud SQL, Render, Railway, AWS RDS)
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/worklog?sslmode=require
# DB_SSL=true
